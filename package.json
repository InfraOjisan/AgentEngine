{
  "name": "agentengine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Multi-harness multi-agent team CUI — orchestrates Claude Code, Codex CLI, Agy, Qwen Code, pi and opencode as a role-based dev team in one shared chat transcript.",
  "type": "module",
  "bin": {
    "agentengine": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "which": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/which": "^3.0.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
